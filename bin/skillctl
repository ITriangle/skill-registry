class SkillctlError(Exception):
    pass


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise SkillctlError(f"missing file: {path}") from exc


def parse_simple_yaml(path: Path) -> dict:
    """Parse the small YAML subset used by registry manifests."""
    data: dict[str, object] = {}
    current_key: str | None = None
    current_item: dict[str, str] | None = None

    for raw_line in read_text(path).splitlines():
        line = raw_line.rstrip()
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        if not line.startswith(" "):
            if ":" not in stripped:
                raise SkillctlError(f"invalid line in {path}: {raw_line}")
            key, value = stripped.split(":", 1)
            key = key.strip()
            value = value.strip()
            if value:
                data[key] = strip_quotes(value)
                current_key = None
            else:
                data[key] = []
                current_key = key
            current_item = None
            continue

        if current_key is None:
            raise SkillctlError(f"indented line without list key in {path}: {raw_line}")

        if stripped.startswith("- "):
            item_text = stripped[2:].strip()
            if not isinstance(data[current_key], list):
                raise SkillctlError(f"{current_key} is not a list in {path}")
            if ":" in item_text:
                item_key, item_value = item_text.split(":", 1)
                current_item = {item_key.strip(): strip_quotes(item_value.strip())}
                data[current_key].append(current_item)
            else:
                current_item = {"value": strip_quotes(item_text)}
                data[current_key].append(current_item)
            continue

        if current_item is None or ":" not in stripped:
            raise SkillctlError(f"unsupported nested YAML in {path}: {raw_line}")
        item_key, item_value = stripped.split(":", 1)
        current_item[item_key.strip()] = strip_quotes(item_value.strip())

    return data


def strip_quotes(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        return value[1:-1]
    return value


def dump_project_manifest(project: str, path: str, skills: list[str]) -> str:
    lines = [f"project: {project}", f"path: {path}", "skills:"]
    for skill_id in skills:
        lines.append(f"  - id: {skill_id}")
    return "\n".join(lines) + "\n"


def project_manifest(project: str) -> Path:
    return PROJECTS_DIR / f"{project}.yaml"


def load_project(project: str) -> dict:
    manifest = project_manifest(project)
    data = parse_simple_yaml(manifest)
    if "path" not in data:
        raise SkillctlError(f"project manifest missing path: {manifest}")
    data.setdefault("skills", [])
    return data


def project_skill_ids(data: dict) -> list[str]:
    result: list[str] = []
    for item in data.get("skills", []):
        if isinstance(item, dict) and "id" in item:
            result.append(str(item["id"]))
        elif isinstance(item, dict) and "value" in item:
            result.append(str(item["value"]))
        else:
            raise SkillctlError(f"invalid skill entry: {item}")
    return result


def skill_path(skill_id: str) -> Path:
    clean_id = skill_id.strip("/")
    if clean_id.startswith("skills/"):
        rel = clean_id
    else:
        rel = f"skills/{clean_id}"
    path = (ROOT / rel).resolve()
    try:
        path.relative_to(ROOT.resolve())
    except ValueError as exc:
        raise SkillctlError(f"skill id escapes registry root: {skill_id}") from exc
    return path


def locale_root(locale: str) -> Path:
    if not re.fullmatch(r"[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*", locale):
        raise SkillctlError(f"invalid locale: {locale}")
    return LOCALES_DIR / locale


def translated_skill_path(skill_id: str, locale: str) -> Path:
    clean_id = skill_id.strip("/")
    if clean_id.startswith("skills/"):
        clean_id = clean_id.removeprefix("skills/")
    path = (locale_root(locale) / clean_id).resolve()
    try:
        path.relative_to(locale_root(locale).resolve())
    except ValueError as exc:
        raise SkillctlError(f"translated skill id escapes locale root: {skill_id}") from exc
    return path


def translatable_files(skill_id: str) -> list[Path]:
    base = skill_path(skill_id)
    result = []
    for path in base.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in {".md", ".txt"}:
            continue
        if path.name.lower().startswith("license"):
            continue
        result.append(path.relative_to(base))
    return sorted(result, key=lambda item: item.as_posix())


def translation_manifest_path(skill_id: str, locale: str) -> Path:
    return translated_skill_path(skill_id, locale) / ".translation.yaml"


def translation_manifest_entries(skill_id: str, locale: str) -> tuple[dict[str, str], dict[str, dict[str, str]]]:
    manifest = translation_manifest_path(skill_id, locale)
    if not manifest.exists():
        return {}, {}
    data = parse_simple_yaml(manifest)
    entries: dict[str, dict[str, str]] = {}
    for item in data.get("files", []):
        if not isinstance(item, dict) or "path" not in item:
            raise SkillctlError(f"invalid translation entry in {manifest}: {item}")
        rel = str(item["path"])
        entries[rel] = {str(key): str(value) for key, value in item.items()}
    header = {
        "locale": str(data.get("locale", "")),
        "source_id": str(data.get("source_id", "")),
    }
    return header, entries


def markdown_links(text: str) -> set[str]:
    links: set[str] = set()
    for target in re.findall(r"(?<!!)\[[^\]]*\]\(([^)]+)\)", text):
        target = target.strip().split(maxsplit=1)[0].strip("<>")
        if target and not target.startswith(("#", "/")) and "://" not in target:
            links.add(target)
    return links


def translation_prose(text: str) -> str:
    """Return natural-language prose while ignoring code and stable identifiers."""
    text = re.sub(r"```.*?```", " ", text, flags=re.DOTALL)
    text = re.sub(r"`[^`]*`", " ", text)
    text = re.sub(r"https?://\S+", " ", text)
    text = re.sub(r"^---\n.*?\n---\n", " ", text, count=1, flags=re.DOTALL)
    return re.sub(r"\s+", " ", text).strip()


def chinese_character_count(text: str) -> int:
    return len(re.findall(r"[\u3400-\u9fff]", text))


def latin_word_count(text: str) -> int:
    return len(re.findall(r"\b[A-Za-z][A-Za-z'-]*\b", text))


def semantic_translation_problems(source_text: str, translated_text: str, label: str) -> list[str]:
    problems: list[str] = []
    if "# 上游说明原文" in translated_text or "# 中文导读" in translated_text:
        problems.append(f"placeholder translation content: {label}")

    source_prose = translation_prose(source_text)
    translated_prose = translation_prose(translated_text)
    source_latin = latin_word_count(source_prose)
    source_chinese = chinese_character_count(source_prose)
    if source_latin < 12 or source_chinese >= max(8, source_latin // 3):
        return problems

    translated_latin = latin_word_count(translated_prose)
    translated_chinese = chinese_character_count(translated_prose)
    if translated_chinese < max(8, translated_latin // 3):
        problems.append(f"insufficient Chinese translation: {label}")

    if len(source_prose) >= 120 and len(translated_prose) >= 120:
        similarity = difflib.SequenceMatcher(
            None,
            source_prose.casefold(),
            translated_prose.casefold(),
            autojunk=False,
        ).ratio()
        if similarity >= 0.72:
            problems.append(f"translation too similar to English source: {label} ({similarity:.0%})")
    return problems


def translation_content_problems(skill_id: str, locale: str) -> list[str]:
    source_dir = skill_path(skill_id)
    translated_dir = translated_skill_path(skill_id, locale)
    expected = {path.as_posix() for path in translatable_files(skill_id)}
    problems: list[str] = []

    if not translated_dir.exists():
        return [f"missing translated skill directory: {skill_id} ({locale})"]

    actual = {
        path.relative_to(translated_dir).as_posix()
        for path in translated_dir.rglob("*")
        if path.is_file() and path.suffix.lower() in {".md", ".txt"}
    }
    for rel in sorted(expected - actual):
        problems.append(f"missing translation: {skill_id}:{rel}")
    for rel in sorted(actual - expected):
        problems.append(f"orphan translation: {skill_id}:{rel}")

    source_skill = source_dir / "SKILL.md"
    translated_skill = translated_dir / "SKILL.md"
    if translated_skill.exists():
        try:
            source_meta = parse_front_matter(read_text(source_skill))
            translated_meta = parse_front_matter(read_text(translated_skill))
            if translated_meta.get("name") != source_meta.get("name"):
                problems.append(f"translated skill name changed: {skill_id}")
            if not re.search(r"[\u3400-\u9fff]", translated_meta.get("description", "")):
                problems.append(f"translated description is not Chinese: {skill_id}")
        except SkillctlError as exc:
            problems.append(f"invalid translated SKILL.md for {skill_id}: {exc}")

    for rel in sorted(expected & actual):
        source_file = source_dir / rel
        translated_file = translated_dir / rel
        problems.extend(
            semantic_translation_problems(
                read_text(source_file),
                read_text(translated_file),
                f"{skill_id}:{rel}",
            )
        )
        if source_file.suffix.lower() != ".md":
            continue
        source_links = markdown_links(read_text(source_file))
        translated_links = markdown_links(read_text(translated_file))
        for link in sorted(source_links):
            clean = link.split("#", 1)[0].split("?", 1)[0]
            if not clean:
                continue
            source_target = (source_file.parent / clean).resolve()
            if source_target.exists() and link not in translated_links:
                problems.append(f"translated link changed or missing: {skill_id}:{rel} -> {link}")
                continue
            target_is_translatable = (
                source_target.exists()
                and source_target.is_file()
                and source_target.suffix.lower() in {".md", ".txt"}
                and not source_target.name.lower().startswith("license")
            )
            if target_is_translatable:
                translated_target = (translated_file.parent / clean).resolve()
                if not translated_target.exists():
                    problems.append(f"broken translated link: {skill_id}:{rel} -> {link}")
    return problems


def translation_problems(skill_id: str, locale: str) -> list[str]:
    problems = translation_content_problems(skill_id, locale)
    manifest = translation_manifest_path(skill_id, locale)
    if not manifest.exists():
        problems.append(f"missing translation manifest: {skill_id} ({locale})")
        return problems

    try:
        header, entries = translation_manifest_entries(skill_id, locale)
    except SkillctlError as exc:
        problems.append(str(exc))
        return problems

    if header.get("locale") != locale:
        problems.append(f"translation manifest locale mismatch: {skill_id}")
    if header.get("source_id") != skill_id:
        problems.append(f"translation manifest source mismatch: {skill_id}")

    expected = {path.as_posix() for path in translatable_files(skill_id)}
    for rel in sorted(expected - set(entries)):
        problems.append(f"translation manifest missing file: {skill_id}:{rel}")
    for rel in sorted(set(entries) - expected):
        problems.append(f"translation manifest has orphan file: {skill_id}:{rel}")
    for rel in sorted(expected & set(entries)):
        source_file = skill_path(skill_id) / rel
        translated_file = translated_skill_path(skill_id, locale) / rel
        if not translated_file.exists():
            continue
        entry = entries[rel]
        if entry.get("source_sha256") != sha256_file(source_file):
            problems.append(f"stale translation source hash: {skill_id}:{rel}")
        if entry.get("translation_sha256") != sha256_file(translated_file):
            problems.append(f"unstamped translation change: {skill_id}:{rel}")
    return problems


def dump_translation_manifest(skill_id: str, locale: str) -> str:
    source_dir = skill_path(skill_id)
    translated_dir = translated_skill_path(skill_id, locale)
    lines = [f"locale: {locale}", f"source_id: {skill_id}", "files:"]
    for rel_path in translatable_files(skill_id):
        rel = rel_path.as_posix()
        translated_file = translated_dir / rel_path
        if not translated_file.exists():
            raise SkillctlError(f"cannot stamp missing translation: {skill_id}:{rel}")
        lines.extend(
            [
                f"  - path: {rel}",
                f"    source_sha256: {sha256_file(source_dir / rel_path)}",
                f"    translation_sha256: {sha256_file(translated_file)}",
            ]
        )
    return "\n".join(lines) + "\n"


def all_translation_problems(locale: str) -> list[str]:
    problems: list[str] = []
    records = skill_records()
    expected_ids = {record["id"] for record in records}
    for record in records:
        problems.extend(translation_problems(record["id"], locale))
    vendor_root = locale_root(locale) / "vendor"
    if vendor_root.exists():
        for translated_dir in sorted(vendor_root.glob("*/*")):
            if not translated_dir.is_dir():
                continue
            translated_id = translated_dir.relative_to(locale_root(locale)).as_posix()
            if translated_id not in expected_ids:
                problems.append(f"orphan translated skill directory: {translated_id} ({locale})")
    return problems


def require_translation_audit(locale: str = DEFAULT_LOCALE) -> None:
    problems = all_translation_problems(locale)
    if problems:
        for problem in problems:
            print(f"translation problem: {problem}", file=sys.stderr)
        raise SystemExit(1)


def validate_skill_dir(path: Path) -> dict[str, str]:
    skill_md = path / "SKILL.md"
    text = read_text(skill_md)
    meta = parse_front_matter(text)
    missing = [key for key in ("name", "description") if not meta.get(key)]
    if missing:
        raise SkillctlError(f"{skill_md} missing metadata: {', '.join(missing)}")
    return meta


def parse_front_matter(text: str) -> dict[str, str]:
    if not text.startswith("---\n"):
        raise SkillctlError("SKILL.md must start with YAML front matter")
    end = text.find("\n---", 4)
    if end == -1:
        raise SkillctlError("SKILL.md front matter is not closed")
    meta: dict[str, str] = {}
    lines = text[4:end].splitlines()
    index = 0
    while index < len(lines):
        raw_line = lines[index]
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            index += 1
            continue
        if ":" not in stripped:
            index += 1
            continue
        key, value = stripped.split(":", 1)
        value = value.strip()
        if value in (">", "|"):
            continuation: list[str] = []
            index += 1
            while index < len(lines) and (not lines[index].strip() or lines[index][0].isspace()):
                continuation.append(lines[index].strip())
                index += 1
            separator = " " if value == ">" else "\n"
            meta[key.strip()] = separator.join(continuation).strip()
            continue
        meta[key.strip()] = strip_quotes(value)
        index += 1
    return meta


def skill_text(skill_id: str) -> str:
    return read_text(skill_path(skill_id) / "SKILL.md")


def skill_dependency_names(skill_id: str) -> list[str]:
    """Return declared skill dependencies that resolve to registered skills."""
    names: list[str] = []
    seen: set[str] = set()
    for name in re.findall(r"`/([A-Za-z0-9][A-Za-z0-9_.-]*)`", skill_text(skill_id)):
        if name in seen or not records_for_name(name):
            continue
        seen.add(name)
        names.append(name)
    skill_name = validate_skill_dir(skill_path(skill_id))["name"]
    for name in EXPLICIT_DEPENDENCIES.get(skill_name, ()):
        if name in seen or not records_for_name(name):
            continue
        seen.add(name)
        names.append(name)
    return names


def resolve_dependency_ref(skill_id: str, dependency_name: str) -> str:
    source = source_from_id(skill_id)
    matching_source = [record for record in records_for_name(dependency_name) if record["source"] == source]
    if len(matching_source) == 1:
        return matching_source[0]["id"]
    return resolve_skill_ref(dependency_name)


def skill_dependency_ids(skill_id: str) -> list[str]:
    return [resolve_dependency_ref(skill_id, name) for name in skill_dependency_names(skill_id)]


def skill_with_dependencies(skill_id: str) -> list[str]:
    ordered: list[str] = []
    seen: set[str] = set()
    visiting: set[str] = set()

    def visit(current_id: str) -> None:
        if current_id in seen:
            return
        if current_id in visiting:
            raise SkillctlError(f"cyclic skill dependency detected at {current_id}")
        visiting.add(current_id)
        validate_skill_dir(skill_path(current_id))
        if current_id not in ordered:
            ordered.append(current_id)
        for dependency_id in skill_dependency_ids(current_id):
            visit(dependency_id)
        visiting.remove(current_id)
        seen.add(current_id)

    visit(skill_id)
    return ordered


def all_source_metadata() -> list[dict]:
    result = []
    for path in sorted(SOURCES_DIR.glob("*.yaml")):
        data = parse_simple_yaml(path)
        data["_path"] = str(path)
        result.append(data)
    return result


def skill_status(skill_id: str) -> str:
    for source in all_source_metadata():
        for item in source.get("skills", []):
            if isinstance(item, dict) and item.get("id") == skill_id:
                return str(item.get("status", "candidate"))
    return "candidate"


def source_from_id(skill_id: str) -> str:
    parts = skill_id.strip("/").split("/")
    if len(parts) >= 3 and parts[0] == "vendor":
        return parts[1]
    return "local"


def skill_records() -> list[dict[str, str]]:
    records = []
    for skill_md in sorted(SKILLS_DIR.glob("vendor/*/*/SKILL.md")):
        skill_dir = skill_md.parent
        rel = str(skill_dir.relative_to(SKILLS_DIR))
        skill_id = f"vendor/{rel.split('vendor/', 1)[-1]}" if "vendor/" in rel else rel
        meta = validate_skill_dir(skill_dir)
        records.append(
            {
                "id": skill_id,
                "name": meta["name"],
                "description": meta["description"],
                "source": source_from_id(skill_id),
                "status": skill_status(skill_id),
                "scripts": str(count_files(skill_dir / "scripts")),
                "references": str(count_reference_files(skill_dir)),
                "description_words": str(len(meta["description"].split())),
            }
        )
    return sorted(records, key=lambda r: (r["name"], r["source"], r["id"]))


def known_skill_names() -> set[str]:
    return {record["name"] for record in skill_records()}


def dependency_names_for_record(record: dict[str, str], names: set[str]) -> list[str]:
    text = read_text(skill_path(record["id"]) / "SKILL.md")
    found: set[str] = set()

    for match in re.findall(r"(?<![\w/.-])/([A-Za-z0-9][A-Za-z0-9_-]*)\b", text):
        if match in names and match != record["name"]:
            found.add(match)

    for match in re.findall(r"\$([A-Za-z0-9][A-Za-z0-9_-]*)\b", text):
        if match in names and match != record["name"]:
            found.add(match)

    found.update(EXPLICIT_DEPENDENCIES.get(record["name"], ()))
    return sorted(found)


def dependency_names_for_records(records: list[dict[str, str]], names: set[str]) -> list[str]:
    found: set[str] = set()
    for record in records:
        found.update(dependency_names_for_record(record, names))
    return sorted(found)


def count_files(path: Path) -> int:
    if not path.exists():
        return 0
    return sum(1 for child in path.rglob("*") if child.is_file())


def count_reference_files(skill_dir: Path) -> int:
    count = 0
    for child in skill_dir.iterdir():
        if child.name in {"SKILL.md", "LICENSE.txt", "scripts"}:
            continue
        if child.is_file():
            count += 1
        elif child.is_dir():
            count += count_files(child)
    return count


def load_skill_groups() -> dict[str, dict[str, str]]:
    if not GROUPS_FILE.exists():
        return {}
    data = parse_simple_yaml(GROUPS_FILE)
    groups = {}
    for item in data.get("groups", []):
        if isinstance(item, dict) and "name" in item:
            groups[str(item["name"])] = {str(k): str(v) for k, v in item.items()}
    return groups


def choose_default(records: list[dict[str, str]], existing_default: str | None = None) -> str:
    ids = {record["id"] for record in records}
    if existing_default in ids:
        return str(existing_default)
    ranked = sorted(
        records,
        key=lambda r: (
            STATUS_RANK.get(r["status"], 99),
            -int(r.get("description_words", "0")),
            -int(r.get("references", "0")),
            -int(r.get("scripts", "0")),
            r["source"],
            r["id"],
        ),
    )
    return ranked[0]["id"]


def group_analysis(name: str, records: list[dict[str, str]], default_id: str) -> tuple[str, str]:
    if len(records) == 1:
        return "单一已注册变体", "单一来源；无需合并决策"

    default_record = next(record for record in records if record["id"] == default_id)
    pieces = []
    status_set = sorted({record["status"] for record in records})
    if len(status_set) > 1:
        pieces.append("状态不同：" + ",".join(status_set))
    source_set = sorted({record["source"] for record in records})
    pieces.append("来源：" + ",".join(source_set))

    descriptions = {record["description"] for record in records}
    if len(descriptions) == 1:
        pieces.append("描述相同")
    else:
        short = sorted(
            f"{record['source']}={record['description_words']}词/{record['references']}参考/{record['scripts']}脚本"
            for record in records
        )
        pieces.append("概况：" + ",".join(short))

    reason = (
        f"推荐 {default_id} 作为 '{name}' 的默认实现，因为它是已选择的合并默认项；"
        f"如需明确选择其他来源，请使用 --source"
    )
    if default_record["status"] == "approved":
        reason = f"推荐 {default_id}，因为它已批准；如需覆盖请选择 --source"
    elif all(record["status"] != "approved" for record in records):
        reason = (
            f"推荐 {default_id} 作为未批准变体中的默认项；"
            "提升为 approved 前请先审查"
        )

    return "; ".join(pieces), reason


def group_usage_guidance(name: str, records: list[dict[str, str]], default_id: str) -> tuple[str, str]:
    if name in USAGE_GUIDANCE:
        return USAGE_GUIDANCE[name]

    default_record = next(record for record in records if record["id"] == default_id)
    return (
        f"当用户需求匹配默认 skill 描述时使用：{default_record['description']}",
        "当需求不匹配上述描述、只是普通对话，或已有更具体的 skill 覆盖时不要用。",
    )


def write_skill_groups() -> None:
    existing = load_skill_groups()
    by_name: dict[str, list[dict[str, str]]] = {}
    records = skill_records()
    names = {record["name"] for record in records}
    for record in records:
        by_name.setdefault(record["name"], []).append(record)

    lines = ["groups:"]
    for name in sorted(by_name):
        records = by_name[name]
        default_id = choose_default(records, existing.get(name, {}).get("default_id"))
        variants = ",".join(record["id"] for record in records)
        sources = ",".join(sorted({record["source"] for record in records}))
        dependencies = ",".join(dependency_names_for_records(records, names)) or "none"
        difference, recommendation = group_analysis(name, records, default_id)
        use_when, avoid_when = group_usage_guidance(name, records, default_id)
        note = (
            "已合并重复 skill 名称；除非指定 --source，否则使用默认项。"
            if len(records) > 1
            else "单一已注册变体。"
        )
        lines.extend(
            [
                f"  - name: {name}",
                f"    default_id: {default_id}",
                f"    variants: {variants}",
                f"    sources: {sources}",
                f"    dependencies: {dependencies}",
                f"    difference: {difference}",
                f"    recommendation: {recommendation}",
                f"    use_when: {use_when}",
                f"    avoid_when: {avoid_when}",
                f"    note: {note}",
            ]
        )
    GROUPS_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")


def records_for_name(name: str) -> list[dict[str, str]]:
    return [record for record in skill_records() if record["name"] == name]


def resolve_skill_ref(skill_ref: str, source: str | None = None) -> str:
    if skill_ref.startswith("vendor/") or skill_ref.startswith("skills/"):
        if source and source_from_id(skill_ref) != source:
            raise SkillctlError(f"{skill_ref} is not from source '{source}'")
        validate_skill_dir(skill_path(skill_ref))
        return skill_ref

    records = records_for_name(skill_ref)
    if not records:
        raise SkillctlError(f"unknown skill name: {skill_ref}")

    if source:
        matching = [record for record in records if record["source"] == source]
        if not matching:
            sources = ", ".join(sorted({record["source"] for record in records}))
            raise SkillctlError(f"skill '{skill_ref}' has no source '{source}' (available: {sources})")
        if len(matching) > 1:
            raise SkillctlError(f"source '{source}' has multiple variants for '{skill_ref}'; use an exact id")
        return matching[0]["id"]

    groups = load_skill_groups()
    default_id = groups.get(skill_ref, {}).get("default_id")
    return choose_default(records, default_id)


def print_alternatives(skill_name: str) -> None:
    records = records_for_name(skill_name)
    if not records:
        raise SkillctlError(f"unknown skill name: {skill_name}")
    default_id = resolve_skill_ref(skill_name)
    difference, recommendation = group_analysis(skill_name, records, default_id)
    dependencies = dependency_names_for_records(records, known_skill_names())
    print(f"{skill_name}: 默认={default_id}")
    print(f"依赖：{','.join(dependencies) if dependencies else 'none'}")
    print(f"差异：{difference}")
    print(f"建议：{recommendation}")
    for record in records:
        marker = " 默认" if record["id"] == default_id else ""
        print(f"- {record['id']} [{record['status']}, source={record['source']}]{marker}")
        print(
            "  概况："
            f"{record['description_words']} 个描述词，"
            f"{record['references']} 个参考文件，"
            f"{record['scripts']} 个脚本"
        )
        print(f"  描述：{record['description']}")


def managed_link_target(path: Path) -> bool:
    if not path.is_symlink():
        return False
    try:
        path.resolve().relative_to(ROOT.resolve())
        return True
    except ValueError:
        return False


def command_list(_: argparse.Namespace) -> None:
    for record in skill_records():
        print(f"{record['id']}\t{record['status']}\t{record['name']}")


def command_translation_status(args: argparse.Namespace) -> None:
    if not args.skill:
        problems = all_translation_problems(args.locale)
        if problems:
            for problem in problems:
                print(f"problem: {problem}")
            raise SystemExit(1)
        print(f"ok: {args.locale} ({len(skill_records())} skills)")
        return

    ids = [resolve_skill_ref(args.skill)]
    problems: list[str] = []
    for skill_id in ids:
        skill_problems = translation_problems(skill_id, args.locale)
        if skill_problems:
            problems.extend(skill_problems)
        else:
            print(f"ok: {skill_id} ({args.locale})")
    if problems:
        for problem in problems:
            print(f"problem: {problem}")
        raise SystemExit(1)


def command_translation_stamp(args: argparse.Namespace) -> None:
    skill_id = resolve_skill_ref(args.skill)
    problems = translation_content_problems(skill_id, args.locale)
    if problems:
        for problem in problems:
            print(f"translation problem: {problem}", file=sys.stderr)
        raise SystemExit(1)
    manifest = translation_manifest_path(skill_id, args.locale)
    manifest.parent.mkdir(parents=True, exist_ok=True)
    manifest.write_text(dump_translation_manifest(skill_id, args.locale), encoding="utf-8")
    print(f"stamped: {skill_id} ({args.locale})")


def command_translation_audit(args: argparse.Namespace) -> None:
    require_translation_audit(args.locale)
    print(f"ok: {args.locale} ({len(skill_records())} skills)")


def command_audit(args: argparse.Namespace) -> None:
    require_translation_audit(DEFAULT_LOCALE)
    data = load_project(args.project)
    project_root = Path(str(data["path"])).expanduser().resolve()
    ids = project_skill_ids(data)
    seen_names: dict[str, str] = {}
    problems: list[str] = []

    for skill_id in ids:
        spath = skill_path(skill_id)
        if not spath.exists():
            problems.append(f"missing skill: {skill_id} -> {spath}")
            continue
        try:
            meta = validate_skill_dir(spath)
        except SkillctlError as exc:
            problems.append(str(exc))
            continue
        status = skill_status(skill_id)
        if status not in VALID_STATUSES:
            problems.append(f"invalid status for {skill_id}: {status}")
        if status != "approved" and not args.allow_candidate:
            problems.append(f"skill is not approved: {skill_id} ({status})")
        name = meta["name"]
        if name in seen_names:
            problems.append(f"duplicate skill name '{name}': {seen_names[name]} and {skill_id}")
        seen_names[name] = skill_id
        for dependency_id in skill_dependency_ids(skill_id):
            if dependency_id not in ids:
                dependency_name = validate_skill_dir(skill_path(dependency_id))["name"]
                problems.append(f"missing dependency for {skill_id}: {dependency_name} -> {dependency_id}")

    active_dir = project_root / ".agents" / "skills"
    if active_dir.exists():
        desired_names = {skill_path(skill_id).name for skill_id in ids}
        for entry in active_dir.iterdir():
            if managed_link_target(entry) and entry.name not in desired_names:
                print(f"stale managed link: {entry}")
            elif entry.is_symlink() and not entry.exists():
                problems.append(f"broken symlink: {entry}")

    if problems:
        for problem in problems:
            print(f"problem: {problem}", file=sys.stderr)
        raise SystemExit(1)
    print(f"ok: {args.project} ({len(ids)} skills)")


def command_sync(args: argparse.Namespace) -> None:
    data = load_project(args.project)
    project_root = Path(str(data["path"])).expanduser().resolve()
    ids = project_skill_ids(data)
    active_dir = project_root / ".agents" / "skills"

    command_audit(SimpleNamespace(project=args.project, allow_candidate=args.allow_candidate))

    desired: dict[str, Path] = {}
    for skill_id in ids:
        spath = skill_path(skill_id)
        desired[spath.name] = spath

    if args.dry_run:
        print(f"would ensure directory: {active_dir}")
    else:
        active_dir.mkdir(parents=True, exist_ok=True)

    for name, target in desired.items():
        link = active_dir / name
        if link.exists() or link.is_symlink():
            if link.is_symlink() and link.resolve() == target.resolve():
                continue
            if managed_link_target(link):
                if args.dry_run:
                    print(f"would replace managed link: {link}")
                else:
                    link.unlink()
            else:
                raise SkillctlError(f"refusing to replace unmanaged path: {link}")
        if args.dry_run:
            print(f"would link: {link} -> {target}")
        else:
            link.symlink_to(target, target_is_directory=True)
            print(f"linked: {link} -> {target}")

    if active_dir.exists():
        for entry in active_dir.iterdir():
            if managed_link_target(entry) and entry.name not in desired:
                if args.dry_run:
                    print(f"would remove stale link: {entry}")
                else:
                    entry.unlink()
                    print(f"removed stale link: {entry}")


def command_enable(args: argparse.Namespace) -> None:
    manifest = project_manifest(args.project)
    data = load_project(args.project)
    ids = project_skill_ids(data)
    skill_id = resolve_skill_ref(args.skill, args.source)
    enabled_ids: list[str] = []
    for resolved_id in skill_with_dependencies(skill_id):
        if resolved_id not in ids:
            ids.append(resolved_id)
            enabled_ids.append(resolved_id)
    manifest.write_text(
        dump_project_manifest(args.project, str(data["path"]), ids),
        encoding="utf-8",
    )
    if enabled_ids:
        for enabled_id in enabled_ids:
            print(f"enabled in manifest: {enabled_id}")
    else:
        print(f"already enabled in manifest: {skill_id}")
    skill_name = validate_skill_dir(skill_path(skill_id))["name"]
    records = records_for_name(skill_name)
    dependencies = dependency_names_for_records(records, known_skill_names())
    print(f"dependencies: {','.join(dependencies) if dependencies else 'none'}")
    if len(records) > 1:
        print("alternatives:")
        print_alternatives(skill_name)


def command_disable(args: argparse.Namespace) -> None:
    manifest = project_manifest(args.project)
    data = load_project(args.project)
    skill_id = resolve_skill_ref(args.skill, args.source)
    ids = [existing_id for existing_id in project_skill_ids(data) if existing_id != skill_id]
    manifest.write_text(
        dump_project_manifest(args.project, str(data["path"]), ids),
        encoding="utf-8",
    )
    print(f"disabled in manifest: {skill_id}")


def command_import(args: argparse.Namespace) -> None:
    dest = skill_path(args.skill_id)
    if dest.exists() and not args.force:
        raise SkillctlError(f"destination exists: {dest}")
    with tempfile.TemporaryDirectory(prefix="skillctl-") as tmp:
        tmp_path = Path(tmp)
        clone_dir = tmp_path / "repo"
        run(["git", "clone", args.repo, str(clone_dir)])
        run(["git", "-C", str(clone_dir), "checkout", args.ref])
        upstream_skill = clone_dir / args.skill_path
        if not upstream_skill.exists():
            raise SkillctlError(f"upstream skill path not found: {args.skill_path}")
        validate_skill_dir(upstream_skill)
        if dest.exists():
            shutil.rmtree(dest)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(
            upstream_skill,
            dest,
            symlinks=True,
            ignore=shutil.ignore_patterns(".git"),
        )
    validate_skill_dir(dest)
    update_source_metadata(args)
    problems = translation_problems(args.skill_id, DEFAULT_LOCALE)
    if problems:
        for problem in problems:
            print(f"translation problem: {problem}", file=sys.stderr)
        print(
            f"imported source but translation requires update: {args.skill_id}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    write_skill_groups()
    print(f"imported: {args.skill_id}")


def run(command: list[str]) -> None:
    subprocess.run(command, check=True)


def update_source_metadata(args: argparse.Namespace) -> None:
    SOURCES_DIR.mkdir(parents=True, exist_ok=True)
    path = SOURCES_DIR / f"{args.source}.yaml"
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    if path.exists():
        text = read_text(path).rstrip() + "\n"
        if f"id: {args.skill_id}" in text:
            return
        text += (
            f"  - id: {args.skill_id}\n"
            f"    upstream_path: {args.skill_path}\n"
            "    status: candidate\n"
            f"    imported_at: {now}\n"
        )
    else:
        text = (
            f"source: {args.source}\n"
            f"repo: {args.repo}\n"
            f"ref: {args.ref}\n"
            "skills:\n"
            f"  - id: {args.skill_id}\n"
            f"    upstream_path: {args.skill_path}\n"
            "    status: candidate\n"
            f"    imported_at: {now}\n"
        )
    path.write_text(text, encoding="utf-8")


def command_analyze(args: argparse.Namespace) -> None:
    spath = skill_path(args.skill_id)
    meta = validate_skill_dir(spath)
    text = read_text(spath / "SKILL.md")
    source, skill_name = source_and_name(args.skill_id)
    out_dir = ANALYSIS_DIR / source
    out_dir.mkdir(parents=True, exist_ok=True)
    report = out_dir / f"{skill_name}.md"

    scripts = sorted(str(p.relative_to(spath)) for p in spath.glob("scripts/**/*") if p.is_file())
    refs = sorted(str(p.relative_to(spath)) for p in spath.glob("references/**/*") if p.is_file())
    mentions = detect_mentions(text)

    body = [
        f"# {args.skill_id}",
        "",
        f"- Skill 名称：`{meta['name']}`",
        f"- 当前状态：`{skill_status(args.skill_id)}`",
        f"- 描述：{meta['description']}",
        "",
        "## 触发条件审查",
        "",
        "- 审查描述是否足够聚焦，适合隐式调用。",
        "- 确认显式触发词是否前置。",
        "",
        "## 依赖与风险",
        "",
        f"- 脚本：{', '.join(scripts) if scripts else '未检测到'}",
        f"- 参考资料：{', '.join(refs) if refs else '未检测到'}",
        f"- 风险提及：{', '.join(mentions) if mentions else '未检测到'}",
        "",
        "## 建议",
        "",
        "- 建议状态：`candidate`",
        "- 仅在检查许可证、脚本行为和触发范围重叠后再批准。",
        "",
    ]
    report.write_text("\n".join(body), encoding="utf-8")
    print(f"analysis written: {report}")


def command_refresh_groups(_: argparse.Namespace) -> None:
    require_translation_audit(DEFAULT_LOCALE)
    write_skill_groups()
    print(f"groups written: {GROUPS_FILE}")


def command_alternatives(args: argparse.Namespace) -> None:
    if args.skill:
        print_alternatives(args.skill)
        return

    by_name: dict[str, list[dict[str, str]]] = {}
    for record in skill_records():
        by_name.setdefault(record["name"], []).append(record)
    for name in sorted(name for name, records in by_name.items() if len(records) > 1):
        print_alternatives(name)


def detect_mentions(text: str) -> list[str]:
    patterns = {
        "网络": r"\b(curl|wget|http|https|api|download|upload)\b",
        "文件系统": r"\b(rm|delete|move|copy|write|chmod|chown)\b",
        "MCP": r"\bMCP\b|\bmcp__",
        "shell": r"\b(shell|bash|zsh|command|script)\b",
        "密钥": r"\b(token|secret|password|api key|credential)\b",
    }
    hits = []
    for label, pattern in patterns.items():
        if re.search(pattern, text, re.IGNORECASE):
            hits.append(label)
    return hits


def source_and_name(skill_id: str) -> tuple[str, str]:
    parts = skill_id.strip("/").split("/")
    if len(parts) >= 3 and parts[0] == "vendor":
        return parts[1], parts[-1]
    return "local", parts[-1]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="skillctl")
    sub = parser.add_subparsers(dest="command", required=True)

    list_p = sub.add_parser("list", help="List vendored skills")
    list_p.set_defaults(func=command_list)

    translation_status_p = sub.add_parser("translation-status", help="Show translation mirror status")
    translation_status_p.add_argument("skill", nargs="?")
    translation_status_p.add_argument("--locale", default=DEFAULT_LOCALE)
    translation_status_p.set_defaults(func=command_translation_status)

    translation_stamp_p = sub.add_parser("translation-stamp", help="Stamp a reviewed translation mirror")
    translation_stamp_p.add_argument("skill")
    translation_stamp_p.add_argument("--locale", default=DEFAULT_LOCALE)
    translation_stamp_p.set_defaults(func=command_translation_stamp)

    translation_audit_p = sub.add_parser("translation-audit", help="Audit all translation mirrors")
    translation_audit_p.add_argument("--locale", default=DEFAULT_LOCALE)
    translation_audit_p.set_defaults(func=command_translation_audit)

    audit_p = sub.add_parser("audit", help="Audit a project manifest")
    audit_p.add_argument("project")
    audit_p.add_argument("--allow-candidate", action="store_true")
    audit_p.set_defaults(func=command_audit)

    sync_p = sub.add_parser("sync", help="Sync project symlinks")
    sync_p.add_argument("project")
    sync_p.add_argument("--dry-run", action="store_true")
    sync_p.add_argument("--allow-candidate", action="store_true")
    sync_p.set_defaults(func=command_sync)

    enable_p = sub.add_parser("enable", help="Add a skill to a project manifest")
    enable_p.add_argument("project")
    enable_p.add_argument("skill")
    enable_p.add_argument("--source", help="Resolve a skill name from a specific source")
    enable_p.set_defaults(func=command_enable)

    disable_p = sub.add_parser("disable", help="Remove a skill from a project manifest")
    disable_p.add_argument("project")
    disable_p.add_argument("skill")
    disable_p.add_argument("--source", help="Resolve a skill name from a specific source")
    disable_p.set_defaults(func=command_disable)

    import_p = sub.add_parser("import", help="Import a skill from a pinned Git ref")
    import_p.add_argument("--source", required=True)
    import_p.add_argument("--repo", required=True)
    import_p.add_argument("--ref", required=True)
    import_p.add_argument("--skill-path", required=True)
    import_p.add_argument("--id", dest="skill_id", required=True)
    import_p.add_argument("--force", action="store_true")
    import_p.set_defaults(func=command_import)

    analyze_p = sub.add_parser("analyze", help="Generate a skill analysis report")
    analyze_p.add_argument("skill_id")
    analyze_p.set_defaults(func=command_analyze)

    refresh_p = sub.add_parser("refresh-groups", help="Rebuild merged skill-name defaults")
    refresh_p.set_defaults(func=command_refresh_groups)

    alternatives_p = sub.add_parser("alternatives", help="Show same-name skill variants")
    alternatives_p.add_argument("skill", nargs="?")
    alternatives_p.set_defaults(func=command_alternatives)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    try:
        args.func(args)
    except SkillctlError as exc:
        die(str(exc))
    except subprocess.CalledProcessError as exc:
        die(f"command failed with exit code {exc.returncode}: {' '.join(exc.cmd)}")


if __name__ == "__main__":
    main()
